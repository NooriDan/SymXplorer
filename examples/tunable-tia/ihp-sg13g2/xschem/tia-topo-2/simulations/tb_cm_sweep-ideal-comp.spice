** sch_path: /foss/designs/eda/SymXplorer/examples/tunable-tia/ihp-sg13g2/xschem/tia-topo-2/tb_cm_sweep-ideal-comp.sch
**.subckt tb_cm_sweep-ideal-comp
V0 VSS GND 0
V2 VDD GND {vdd}
V1 Vbias GND {vbias}
C1 Von GND {cload} m=1
C2 Vop GND {cload} m=1
Icm net1 GND {icm}
x_dut VDD Vop VSS Von Vbias In Ip tia-bpf-2-ideal-comp
Vmeas In net1 0
.save i(vmeas)
Vmeas1 Ip net2 0
.save i(vmeas1)
F1 net2 GND Vmeas -1
**** begin user architecture code


****** START OF CONTROL SECTION ******


.control

    echo ==================================
    echo start of Control
    echo ==================================

    save all

    echo
    echo (A) start of OP
    echo ----------------------------------

    * operating point
    op

    print all

    write op.raw

    echo ----------------------------------
    echo END of OP
    echo ----------------------------------

    set appendwrite

    echo
    echo (B) start of DC Sim
    echo ----------------------------------

    echo sweeping Icm...
    dc Icm 0 2e-3 100e-6
    plot vop von
    plot v.x_dut.vmeas#branch


    echo sweeping Vbias...
    dc V1 0 1.2 0.01
    plot vop von
    plot v.x_dut.vmeas#branch


    echo ----------------------------------
    echo END of DC sim
    echo  ----------------------------------

    echo SAVING SIMULATION RESULTS IN THE RAW FILE
    save all
    write

    echo ==================================
    echo END of Control
    echo ==================================
.endc
******  END OF CONTROL SECTION ******



********** Models ************
.lib cornerMOSlv.lib mos_tt
.lib cornerRES.lib res_typ
.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib cap_typ
********** END of Models ************




