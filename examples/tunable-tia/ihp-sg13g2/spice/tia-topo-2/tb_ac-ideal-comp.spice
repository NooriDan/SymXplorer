******  End of Save Statements ******




****** TB Parameters ******
.param icm=0.5e-6
.param vdd=1.2
.param vbias=0.5
.param cload=10p
******  End of TB Params ******




****** All DUT parameters ******

* MOSFET PARAMETERS
.param x_dut_nfet_w=0.40u
.param x_dut_nfet_l=0.26u
.param x_dut_nfet_m=10

* PASSIVE ELEMENT PARAMETERS

.param x_dut_cap_size=50p
.param x_dut_res_load_size=1k
.param x_dut_res_2_size=1.0k
.param x_dut_ind_size=1.0n

****** END of DUT Params ******


