.subckt tia-bpf-2-ideal-comp vdd vop vss von vbias inn inp
*.iopin vdd
*.iopin vss
*.ipin inp
*.ipin inn
*.opin von
*.opin vop
*.ipin vbias
XM1 vop vbias inn vss sg13_lv_nmos w={x_dut_nfet_w} l={x_dut_nfet_l} ng=1 m={x_dut_nfet_m} rfmode=1
XM2 von vbias inp vss sg13_lv_nmos w={x_dut_nfet_w} l={x_dut_nfet_l} ng=1 m={x_dut_nfet_m} rfmode=1
L2 inp vss {x_dut_ind_size} m=1
L3 inn vss {x_dut_ind_size} m=1
C1 inp vss {x_dut_cap_size} m=1
C2 inn vss {x_dut_cap_size} m=1
R1 vdd von {x_dut_res_load_size} m=1
R2 vdd vop {x_dut_res_load_size} m=1
R3 vop inn {x_dut_res_2_size} m=1
R4 von inp {x_dut_res_2_size} m=1
.ends

